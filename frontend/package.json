{
  "name": "lunchsync-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:realtime": "vitest run src/test/integration/notification-hooks.integration.test.tsx src/test/integration/notifications-realtime.integration.test.tsx src/test/performance/notifications-query-metrics.test.tsx --pool threads",
    "test:realtime:perf": "node scripts/compare-realtime.cjs"
  },
