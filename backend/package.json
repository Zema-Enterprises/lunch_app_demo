{
  "name": "lunchsync-backend",
  "version": "1.0.0",
  "description": "LunchSync Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "push:vapid:generate": "web-push generate-vapid-keys",
    "test:realtime": "jest --runTestsByPath src/__tests__/integration/notifications.gateway.smoke.test.ts --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^2.4.0",
    "cors": "^2.8.0",
    "dompurify": "^3.2.7",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "resend": "^6.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.9.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
